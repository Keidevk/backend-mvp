datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id              String    @id @default(uuid())
  name            String    // Nombre del negocio
  whatsappNumber  String?   // Número personal para alertas
  messageCredits  Int       @default(0) // Contador para el cobro por mensaje
  botActive       Boolean   @default(false)
  promptConfig    String?   // "Personalidad" del bot
  createdAt       DateTime  @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float    // Guardado en USD
  stock       Int
  client_id   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
   
   @@index([client_id])
}

model User {
  id             String   @id @default(uuid())
  clientId       String   @unique @map("client_id")
  email          String   @unique
  password       String
  companyName    String   @map("company_name")
  phoneNumber    String   @map("phone_number")
  apiKey         String   @unique @map("api_key")
  messageCredits Int      @default(0) @map("message_credits")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  bot          Bot?
  messages     Message[]
  
  @@map("users")
}

model Bot {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  isActive          Boolean   @default(false) @map("is_active")
  whatsappSessionId String?   @map("whatsapp_session_id")
  connectedAt       DateTime? @map("connected_at")
  disconnectedAt    DateTime? @map("disconnected_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  
  @@map("bots")
}

model Message {
  id             String    @id @default(uuid())
  botId          String    @map("bot_id")
  userId         String    @map("user_id")
  direction      String    // 'incoming' o 'outgoing'
  customerNumber String?   @map("customer_number")
  sentAt         DateTime  @default(now()) @map("sent_at")
  
  bot   Bot  @relation(fields: [botId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id])
  
  @@index([botId, sentAt])
  @@map("messages")
}

model ChatLog {
  id                String   @id @default(uuid())
  clientId          String   @map("client_id")
  customerPhone     String?  @map("customer_phone")
  userMessage       String   @map("user_message")
  botResponse       String   @map("bot_response")
  extractedKeyword  String?  @map("extracted_keyword")
  requiresAttention Boolean  @default(false) @map("requires_attention")
  attended          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@map("chat_logs")
}