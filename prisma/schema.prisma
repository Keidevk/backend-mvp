datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int
  client_id   String   // Clave para multitenencia
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([client_id])
}